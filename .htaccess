# Custom error pages
ErrorDocument 404 /404.php
ErrorDocument 403 /404.php

# Never serve config or data sources directly
<FilesMatch "^(config\.php|config\.sample\.php)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(data|lib|sql|tools|storage)/
# Applicants upload IBAN certificates and ID copies here. They are personal
# documents, so they are never served directly; the committee reads them
# through an authenticated action instead.
RedirectMatch 404 ^/uploads/

# Long-cache immutable assets, short-cache markup
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp   "access plus 1 year"
  ExpiresByType image/png    "access plus 1 year"
  ExpiresByType video/mp4    "access plus 1 year"
  ExpiresByType font/otf     "access plus 1 year"
  ExpiresByType text/css     "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml
</IfModule>
